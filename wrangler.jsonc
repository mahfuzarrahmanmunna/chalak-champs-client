{
  "$schema": "node_modules/wrangler/config-schema.json",
  "service": "lingual-academy",
  "compatibility_date": "2025-09-27",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
    },
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "chalak-champs-client",
    },
  ],
}
